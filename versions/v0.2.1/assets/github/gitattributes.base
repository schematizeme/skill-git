* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
package-lock.json -diff linguist-generated
Cargo.lock -diff linguist-generated
go.sum -diff linguist-generated
# Binário versionado inevitável: Git LFS
